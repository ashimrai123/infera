# Copy this file to .env and fill in your actual keys.
# .env is gitignored -- never commit real API keys.

# Google Gemini -- FREE tier, no credit card required.
# Get a key at: aistudio.google.com → Get API key
GEMINI_API_KEY=AIza...

# OpenAI -- requires billing (paid)
OPENAI_API_KEY=sk-...

# Anthropic -- requires billing (paid, $5 minimum)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: point at a local Ollama instance.
# Default is http://localhost:11434
# OLLAMA_URL=http://localhost:11434

# Demo mode: enables /v1/debug/* endpoints and the demo-* model routes.
# Set to true for the live demo. Never expose without auth in production.
# DEMO_MODE=true

# CORS: set to * or a specific origin when the frontend is on a different domain.
# Leave unset when the UI is served by infera itself (same origin).
# CORS_ORIGIN=*
